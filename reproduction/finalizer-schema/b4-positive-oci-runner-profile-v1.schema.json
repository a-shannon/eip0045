    "RuntimeObservationSelectorSet": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "processIdentity", "namespaces", "idMappings", "mountinfo", "securityStatus", "cgroupV2", "rootIdentity", "auxv", "processMappings", "smokeIdentity"],
      "properties": {
        "state": {"const": "eip0045-b4-runtime-observation-runc-state-json-v1"},
        "processIdentity": {"const": "eip0045-b4-runtime-observation-linux-boot-id-pid-starttime-jcs-v1"},
        "namespaces": {"const": "eip0045-b4-runtime-observation-namespaces-reserved-v1"},
        "idMappings": {"const": "eip0045-b4-runtime-observation-id-mappings-reserved-v1"},
        "mountinfo": {"const": "eip0045-b4-runtime-observation-mountinfo-reserved-v1"},
        "securityStatus": {"const": "eip0045-b4-runtime-observation-security-status-reserved-v1"},
        "cgroupV2": {"const": "eip0045-b4-runtime-observation-cgroup-v2-reserved-v1"},
        "rootIdentity": {"const": "eip0045-b4-runtime-observation-root-identity-reserved-v1"},
        "auxv": {"const": "eip0045-b4-runtime-observation-auxv-reserved-v1"},
        "processMappings": {"const": "eip0045-b4-runtime-observation-process-mappings-reserved-v1"},
