    "OciImageIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "retainedHostRootfsMetadataPolicy", "imageSpec", "layoutVersion", "archive", "manifest", "config", "platform", "layers", "postChangesetRootfs"],
      "properties": {
        "policy": {"const": "eip0045-b4-oci-image-v1"},
        "retainedHostRootfsMetadataPolicy": {"const": "eip0045-b4-retained-host-rootfs-metadata-obligations-v1"},
        "imageSpec": {"$ref": "#/$defs/OciImageSpecPin"},
        "layoutVersion": {"const": "1.0.0"},
        "archive": {"$ref": "#/$defs/OciImageArchiveIdentity"},
        "manifest": {"$ref": "#/$defs/ManifestDescriptor"},
        "config": {"$ref": "#/$defs/ConfigDescriptor"},
        "platform": {"$ref": "#/$defs/Platform"},
        "layers": {
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": {"$ref": "#/$defs/LayerIdentity"}
        },
        "postChangesetRootfs": {"$ref": "#/$defs/PostChangesetRootfs"}
      }
    },
    "OciRuntimeIdentity": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "runtimeSpec", "configurationPolicy", "observationSelectors", "binary"],
      "properties": {
        "name": {"const": "runc"},
        "version": {"const": "1.3.0"},
        "runtimeSpec": {"$ref": "#/$defs/OciRuntimeSpecPin"},
        "configurationPolicy": {"const": "eip0045-b4-oci-runtime-config-projection-v1"},
        "observationSelectors": {"$ref": "#/$defs/RuntimeObservationSelectorSet"},
        "binary": {"$ref": "#/$defs/BinaryIdentity"}
      }
