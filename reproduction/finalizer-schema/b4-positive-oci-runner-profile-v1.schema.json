{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ergo:eip-0045:b4-positive-oci-runner-profile-v1",
  "title": "Eip0045B4PositiveOciRunnerProfileV1",
  "description": "Finalizer-owned closed OCI runner profile for one B4 validator build or verification role. It carries no validator command, case data, expected outcome, or descriptor-selected policy.",
  "$comment": "This positive-finalizer schema is outside the legacy candidate-schema quarantine. Normative archive, changeset, rootfs, runtime, and seccomp semantics are in docs/specs/b4-oci-execution-policy-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "runnerProfileIndex", "purpose", "platform", "image", "runtime", "seccomp", "environment", "policy", "limits"],
  "properties": {
    "format": {"const": "Eip0045B4PositiveOciRunnerProfileV1"},
    "formatVersion": {"const": 1},
    "runnerProfileIndex": {"type": "integer", "minimum": 0, "maximum": 3},
    "purpose": {"enum": ["rust-validator-build", "jvm-validator-build", "rust-validator", "jvm-validator"]},
    "platform": {"$ref": "#/$defs/Platform"},
    "image": {"$ref": "#/$defs/OciImageIdentity"},
    "runtime": {"$ref": "#/$defs/OciRuntimeIdentity"},
    "seccomp": {"$ref": "#/$defs/SeccompIdentity"},
    "environment": {"$ref": "#/$defs/ExecutionEnvironment"},
    "buildJdk": {"$ref": "#/$defs/BuildJdk"},
    "javaRuntime": {"$ref": "#/$defs/JavaRuntime"},
    "policy": {
      "oneOf": [
        {"$ref": "#/$defs/RustBuildPolicy"},
        {"$ref": "#/$defs/JvmBuildPolicy"},
        {"$ref": "#/$defs/RustVerificationPolicy"},
        {"$ref": "#/$defs/JvmVerificationPolicy"}
      ]
    },
    "limits": {
      "oneOf": [
        {"$ref": "#/$defs/BuildLimits"},
        {"$ref": "#/$defs/VerificationLimits"}
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {"not": {"anyOf": [{"required": ["buildJdk"]}, {"required": ["javaRuntime"]}]}, "properties": {"runnerProfileIndex": {"const": 0}, "purpose": {"const": "rust-validator-build"}, "policy": {"$ref": "#/$defs/RustBuildPolicy"}, "limits": {"$ref": "#/$defs/BuildLimits"}}},
        {"required": ["buildJdk"], "not": {"required": ["javaRuntime"]}, "properties": {"runnerProfileIndex": {"const": 1}, "purpose": {"const": "jvm-validator-build"}, "buildJdk": {"$ref": "#/$defs/BuildJdk"}, "policy": {"$ref": "#/$defs/JvmBuildPolicy"}, "limits": {"$ref": "#/$defs/BuildLimits"}}},
        {"not": {"anyOf": [{"required": ["buildJdk"]}, {"required": ["javaRuntime"]}]}, "properties": {"runnerProfileIndex": {"const": 2}, "purpose": {"const": "rust-validator"}, "policy": {"$ref": "#/$defs/RustVerificationPolicy"}, "limits": {"$ref": "#/$defs/VerificationLimits"}}},
        {"required": ["javaRuntime"], "not": {"required": ["buildJdk"]}, "properties": {"runnerProfileIndex": {"const": 3}, "purpose": {"const": "jvm-validator"}, "javaRuntime": {"$ref": "#/$defs/JavaRuntime"}, "policy": {"$ref": "#/$defs/JvmVerificationPolicy"}, "limits": {"$ref": "#/$defs/VerificationLimits"}}}
      ]
    }
  ],
  "$defs": {
    "Hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "RelativePath": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,239}$",
      "allOf": [
        {"not": {"pattern": "/$"}},
        {"not": {"pattern": "(^|/)\\.{1,2}($|/)"}},
        {"not": {"pattern": "//"}},
        {"not": {"pattern": "(^|/)[^/]*\\.($|/)"}},
        {"not": {"pattern": "(^|/)(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[^/]*)?($|/)"}}
      ]
    },
    "Platform": {
      "type": "object", "additionalProperties": false, "required": ["os", "architecture"],
      "properties": {"os": {"const": "linux"}, "architecture": {"const": "amd64"}}
    },
    "StaticElfInspection": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "elfType", "osAbi", "programHeaderCount", "sectionHeaderCount", "loadSegmentCount", "executableLoadSegmentCount", "entryPointInExecutableLoad", "interpreterSegmentCount", "dynamicSegmentCount", "gnuStackSegmentCount", "writableExecutableLoadSegmentCount", "executableStackSegmentCount", "overlappingLoadFileRangeCount", "extendedNumberingCount", "structuralParseFailureCount"],
      "properties": {
        "policy": {"const": "eip0045-b4-elf64-amd64-structural-v1"},
        "elfType": {"enum": ["et-exec", "et-dyn"]},
        "osAbi": {"enum": ["sysv", "linux"]},
        "programHeaderCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "sectionHeaderCount": {"type": "integer", "minimum": 0, "maximum": 65279},
        "loadSegmentCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "executableLoadSegmentCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "entryPointInExecutableLoad": {"const": true},
        "interpreterSegmentCount": {"const": 0},
        "dynamicSegmentCount": {"const": 0},
        "gnuStackSegmentCount": {"const": 1},
        "writableExecutableLoadSegmentCount": {"const": 0},
        "executableStackSegmentCount": {"const": 0},
        "overlappingLoadFileRangeCount": {"const": 0},
        "extendedNumberingCount": {"const": 0},
        "structuralParseFailureCount": {"const": 0}
      }
    },
    "RuntimeElfInspection": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "elfType", "osAbi", "programHeaderCount", "sectionHeaderCount", "loadSegmentCount", "executableLoadSegmentCount", "entryPointInExecutableLoad", "interpreterSegmentCount", "interpreterPath", "dynamicSegmentCount", "dynamicEntryCount", "neededLibraryCount", "gnuStackSegmentCount", "writableExecutableLoadSegmentCount", "executableStackSegmentCount", "overlappingLoadFileRangeCount", "extendedNumberingCount", "structuralParseFailureCount"],
      "properties": {
        "policy": {"const": "eip0045-b4-elf64-amd64-structural-v1"},
        "elfType": {"enum": ["et-exec", "et-dyn"]},
        "osAbi": {"enum": ["sysv", "linux"]},
        "programHeaderCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "sectionHeaderCount": {"type": "integer", "minimum": 0, "maximum": 65279},
        "loadSegmentCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "executableLoadSegmentCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "entryPointInExecutableLoad": {"const": true},
        "interpreterSegmentCount": {"const": 1},
        "interpreterPath": {
          "type": "string", "minLength": 2, "maxLength": 240,
          "pattern": "^/(?:[\\x20-\\x2e\\x30-\\x7e]+/)*[\\x20-\\x2e\\x30-\\x7e]+$",
          "allOf": [
            {"not": {"pattern": "//"}},
            {"not": {"pattern": "(^|/)\\.{1,2}($|/)"}}
          ]
        },
        "dynamicSegmentCount": {"const": 1},
        "dynamicEntryCount": {"type": "integer", "minimum": 1, "maximum": 65534},
        "neededLibraryCount": {"type": "integer", "minimum": 0, "maximum": 4096},
        "gnuStackSegmentCount": {"const": 1},
        "writableExecutableLoadSegmentCount": {"const": 0},
        "executableStackSegmentCount": {"const": 0},
        "overlappingLoadFileRangeCount": {"const": 0},
        "extendedNumberingCount": {"const": 0},
        "structuralParseFailureCount": {"const": 0}
      }
    },
    "BinaryIdentity": {
      "type": "object", "additionalProperties": false, "required": ["path", "byteLength", "sha256", "encoding", "fileFormat", "architecture", "linkage", "inspectionPolicy", "elf"],
      "properties": {
        "path": {"$ref": "#/$defs/RelativePath"},
        "byteLength": {"type": "integer", "minimum": 64, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/Hex32"},
        "encoding": {"const": "raw-bytes"},
        "fileFormat": {"const": "elf64"},
        "architecture": {"const": "amd64"},
        "linkage": {"const": "static-no-interpreter"},
        "inspectionPolicy": {"const": "eip0045-b4-elf64-amd64-static-v1"},
        "elf": {"$ref": "#/$defs/StaticElfInspection"}
      }
    },
    "SeccompDocumentIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "path", "byteLength", "sha256", "encoding"],
      "properties": {
        "format": {"const": "Eip0045B4PositiveSeccompV1"},
        "path": {"$ref": "#/$defs/RelativePath"},
        "byteLength": {"type": "integer", "minimum": 2, "maximum": 1048576},
        "sha256": {"$ref": "#/$defs/Hex32"},
        "encoding": {"const": "rfc8785-jcs"}
      }
    },
    "OciImageArchiveIdentity": {
      "type": "object", "additionalProperties": false, "required": ["path", "byteLength", "sha256", "encoding"],
      "properties": {
        "path": {"$ref": "#/$defs/RelativePath"},
        "byteLength": {"type": "integer", "minimum": 6144, "maximum": 17179869184, "multipleOf": 512},
        "sha256": {"$ref": "#/$defs/Hex32"},
        "encoding": {"const": "eip0045-b4-oci-image-layout-ustar-v1"}
      }
    },
    "OciImageSpecPin": {
      "type": "object", "additionalProperties": false, "required": ["version", "commit"],
      "properties": {
        "version": {"const": "1.1.1"},
        "commit": {"const": "147f9c13cedb47a0c4d9a11a222961073d585877"}
      }
    },
    "OciRuntimeSpecPin": {
      "type": "object", "additionalProperties": false, "required": ["version", "commit"],
      "properties": {
        "version": {"const": "1.3.0"},
        "commit": {"const": "92249139eea7161e13745abd4cb6d0ea02a3227a"}
      }
    },
    "ManifestDescriptor": {
      "type": "object", "additionalProperties": false, "required": ["mediaType", "digest", "size"],
      "properties": {
        "mediaType": {"const": "application/vnd.oci.image.manifest.v1+json"},
