          "terminal-fixture-catalog",
          "positive-registry",
          "expanded-negative-registry",
          "mutation-identities",
          "rust-negative-results",
          "jvm-negative-results",
          "semantic-report",
          "tree-manifest",
          "lock",
          "unregistered-extra"
        ]
      }
    }
  }
}
