{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ergo:eip-0045:b4-trusted-host-request-v1",
  "title": "Eip0045B4TrustedHostRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "realization", "command", "campaignRoot", "priorRoots", "outerFinalRoot", "configuredExecutorArtifact", "buildEvidenceRootIndex", "sources"],
  "properties": {
    "format": {"const": "Eip0045B4TrustedHostRequestV1"},
    "formatVersion": {"const": 1},
    "realization": {"const": "trusted-host-v1"},
    "command": {"enum": ["prepare-input-set", "prepare-campaign-precommit", "finalize-generation-set"]},
    "campaignRoot": {"$ref": "#/$defs/absolute"},
    "priorRoots": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/absolute"}},
    "outerFinalRoot": {"$ref": "#/$defs/absolute"},
    "configuredExecutorArtifact": {"$ref": "#/$defs/absolute"},
    "buildEvidenceRootIndex": {"type": "integer", "minimum": 0, "maximum": 15},
    "inputSetPath": {"type": "string"}, "guestElfPath": {"type": "string"},
    "proofGeneratorPath": {"type": "string"},
    "inputSetRequestByteLength": {"type": "integer", "minimum": 1, "maximum": 65536},
    "inputSetRequestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {"type": "object", "minProperties": 11, "maxProperties": 4206,
      "additionalProperties": {"$ref": "#/$defs/locator"}}
  },
  "allOf": [
    {"if": {"properties": {"command": {"const": "prepare-input-set"}}},
      "then": {"required": ["inputSetPath", "guestElfPath", "proofGeneratorPath"],
        "not": {"anyOf": [{"required": ["inputSetRequestByteLength"]}, {"required": ["inputSetRequestSha256"]}]},
        "properties": {"priorRoots": {"maxItems": 2}, "buildEvidenceRootIndex": {"maximum": 1},
          "sources": {"minProperties": 22, "maxProperties": 22,
          "required": ["profileManifest", "profileAlgorithm", "profileConstants", "referenceStatementBundle",
            "sourceLock", "verifierContract", "runnerProfile0", "runnerProfile1", "runnerProfile2", "runnerProfile3",
            "seccomp0", "seccomp1", "seccomp2", "seccomp3", "validatorDescriptor0", "validatorDescriptor1",
            "jvmInclusion", "calibration0", "calibration1", "calibration2", "executorArtifact", "executorBuildDescriptor"]}}},
      "else": {"if": {"properties": {"command": {"const": "prepare-campaign-precommit"}}},
        "then": {"required": ["inputSetRequestByteLength", "inputSetRequestSha256"],
        "not": {"anyOf": [{"required": ["inputSetPath"]}, {"required": ["guestElfPath"]}, {"required": ["proofGeneratorPath"]}]},
        "properties": {"priorRoots": {"maxItems": 2}, "buildEvidenceRootIndex": {"maximum": 1},
          "sources": {"minProperties": 45, "maxProperties": 45,
          "required": ["inputSet", "inputSetCompletion", "campaignExecutorArtifact", "executorSourceArchive",
            "executorBuildDescriptor", "executorContract", "verifierContract", "verifierCliSpec", "negativePlan",
            "expectationSet", "jvmInclusion", "schema0", "schema1", "schema2", "schema3", "schema4",
            "schema5", "schema6", "schema7", "schema8", "schema9", "schema10", "schema11", "schema12",
            "schema13", "schema14", "schema15", "schema16", "schema17", "schema18", "schema19",
            "validatorDescriptor0", "validatorDescriptor1", "validatorArtifact0", "validatorArtifact1",
            "validatorSourceArchive0", "validatorSourceArchive1", "runnerProfile0", "runnerProfile1",
            "runnerProfile2", "runnerProfile3", "seccomp0", "seccomp1", "seccomp2", "seccomp3"]}}},
        "else": {"not": {"anyOf": [{"required": ["inputSetPath"]}, {"required": ["guestElfPath"]},
          {"required": ["proofGeneratorPath"]}, {"required": ["inputSetRequestByteLength"]},
          {"required": ["inputSetRequestSha256"]}]},
          "properties": {"sources": {"minProperties": 110,
            "required": ["campaignPrecommit", "precommitRequest", "inputSet", "inputSetCompletion",
              "proofGenerator", "runnerProfile0", "runnerProfile1", "runnerProfile2", "runnerProfile3",
              "validatorDescriptor0", "validatorDescriptor1"]}}}}}
  ],
  "$defs": {
    "absolute": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "locator": {"type": "object", "additionalProperties": false,
      "required": ["rootIndex", "relativePath"],
      "properties": {"rootIndex": {"type": "integer", "minimum": 0, "maximum": 15}, "relativePath": {"type": "string", "minLength": 1, "maxLength": 240}}}
  }
}
