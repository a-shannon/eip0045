{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ergo:eip-0045:b4-semantic-report-v1",
  "title": "Eip0045B4SemanticReportV1",
  "description": "Structural shape for compact commitments to the 254-execution, 508-result B4 negative campaign. A schema-valid report confers no campaign authority. A production authority/finalizer constructor remains unavailable until the opaque precommit, positive-generation, negative-materialization-set, and 508 physical-run authorities independently re-establish every commitment.",
  "$comment": "Do not authorize a report from caller-supplied replay adapters, raw observations, or raw attributed results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "negativePlan",
    "expandedRegistry",
    "expectationSet",
    "validators",
    "domainTotals",
    "executionCount",
    "resultCount",
    "executions"
  ],
  "properties": {
    "format": {
      "const": "Eip0045B4SemanticReportV1"
    },
    "formatVersion": {
      "const": 1
    },
    "negativePlan": {
      "$ref": "#/$defs/ByteIdentity"
    },
    "expandedRegistry": {
      "$ref": "#/$defs/ByteIdentity"
    },
    "expectationSet": {
      "$ref": "#/$defs/ByteIdentity"
    },
    "validators": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        {
          "$ref": "#/$defs/RustValidator"
        },
        {
          "$ref": "#/$defs/JvmValidator"
        }
      ],
      "items": false
    },
    "domainTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierInput",
        "artifactValidator",
        "treeValidator"
      ],
      "properties": {
        "verifierInput": {
          "const": 131
        },
        "artifactValidator": {
          "const": 102
        },
        "treeValidator": {
          "const": 21
        }
      }
    },
    "executionCount": {
      "const": 254
    },
    "resultCount": {
      "const": 508
    },
    "executions": {
      "type": "array",
      "minItems": 254,
      "maxItems": 254,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Execution"
      }
    }
  },
  "$defs": {
    "Hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ExecutionId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 386,
      "pattern": "^[a-z](?:[a-z0-9]|-[a-z0-9])*--[a-z](?:[a-z0-9]|-[a-z0-9])*$"
    },
    "ByteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "$ref": "#/$defs/Hex32"
        }
      }
    },
    "ArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "$ref": "#/$defs/Hex32"
        }
      }
    },
    "RustValidator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "artifact",
        "buildDescriptor"
      ],
      "properties": {
        "implementation": {
          "const": "rust-reference"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "buildDescriptor": {
          "$ref": "#/$defs/ByteIdentity"
        }
      }
    },
    "JvmValidator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "artifact",
        "buildDescriptor"
      ],
      "properties": {
        "implementation": {
          "const": "independent-jvm"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "buildDescriptor": {
          "$ref": "#/$defs/ByteIdentity"
        }
      }
    },
    "RustSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "observation",
        "result"
      ],
      "properties": {
        "implementation": {
          "const": "rust-reference"
        },
        "observation": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "result": {
          "$ref": "#/$defs/ByteIdentity"
        }
      }
    },
    "JvmSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "observation",
        "result"
      ],
      "properties": {
        "implementation": {
          "const": "independent-jvm"
        },
        "observation": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "result": {
          "$ref": "#/$defs/ByteIdentity"
        }
      }
    },
    "Execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionIndex",
        "executionId",
        "materializationIdentity",
        "negativeInput",
        "slots"
      ],
      "properties": {
        "executionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253
        },
        "executionId": {
          "$ref": "#/$defs/ExecutionId"
        },
        "materializationIdentity": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "negativeInput": {
          "$ref": "#/$defs/ByteIdentity"
        },
        "slots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RustSlot"
            },
            {
              "$ref": "#/$defs/JvmSlot"
            }
          ],
          "items": false
        }
      }
    }
  }
}
