{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ergo:eip-0045:b4-positive-seccomp-v1",
  "title": "Eip0045B4PositiveSeccompV1",
  "description": "Closed B4 seccomp wrapper. The linuxSeccomp member is the exact object inserted into the OCI runtime configuration; the wrapper itself is never passed to runc.",
  "$comment": "This positive-finalizer schema is outside the legacy candidate-schema quarantine. Cross-document projection, canonical encoding, and executor obligations are in docs/specs/b4-oci-execution-policy-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "linuxSeccomp"],
  "properties": {
    "format": {"const": "Eip0045B4PositiveSeccompV1"},
    "formatVersion": {"const": 1},
    "linuxSeccomp": {"$ref": "#/$defs/LinuxSeccomp"}
  },
  "$defs": {
    "SyscallName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+$"
    },
    "AllowRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "action", "args"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/SyscallName"}
        },
        "action": {"const": "SCMP_ACT_ALLOW"},
        "args": {"type": "array", "maxItems": 0}
      }
    },
    "LinuxSeccomp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultAction", "defaultErrnoRet", "architectures", "flags", "syscalls"],
      "properties": {
        "defaultAction": {"const": "SCMP_ACT_ERRNO"},
        "defaultErrnoRet": {"const": 1},
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{"const": "SCMP_ARCH_X86_64"}],
          "items": false
        },
        "flags": {"type": "array", "maxItems": 0},
        "syscalls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{"$ref": "#/$defs/AllowRule"}],
          "items": false
        }
      }
    }
  }
}
