+    FriInnerQuery { query: usize },
+    /// One FRI folding round found `data_ext[quot] != goal`.
+    FriRoundGoal { query: usize, round: usize },
+    /// The final FRI polynomial evaluation found `fx != goal`.
+    FriFinalPolynomial { query: usize },
